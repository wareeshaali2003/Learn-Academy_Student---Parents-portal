# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Enable the "Google Classroom API" on the same project first.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Must exactly match an "Authorized redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Where the student portal frontend runs — used to redirect back after consent
FRONTEND_URL="http://localhost:3000"

# Port this backend listens on
CLASSROOM_SERVER_PORT=4000

# Optional: override the SQLite file location (defaults to server/classroom.sqlite3)
# CLASSROOM_DB_PATH="/absolute/path/to/classroom.sqlite3"
